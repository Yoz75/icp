{
	"authors": [
		"yoz75"
	],
	"subPackages": [
		"cereslib"
	],
	"versions": [
		"CereslibEnableDebugLogs",
		"CereslibEnableLogs"
	],
	"license": "MIT",
	"targetPath": "./bin/",
	"copyright": "Copyright © 2026, yoz75",
	"name": "icp",
	"copyFiles": [
		"resources/runtime/Resources/"
	],
	"stringImportPaths": [
		"resources/compiletime"
	],
	"description": "An image color processor that processes image color",
	"dependencies": {
		"icp:cereslib": "*",
		"arsd-official:image_files": "~>12.1.2",
		"dlangui": "~>0.10.8"
	},
	"buildTypes": {
		"release-lto": {
			"dflags": [
				"--boundscheck=off",
				"--enable-asserts=false",
				"--enable-invariants=false",
				"-O3",
				"-release",
				"-flto=full",
				"-defaultlib=phobos2-ldc-lto,druntime-ldc-lto"
			]
		}
	}
}