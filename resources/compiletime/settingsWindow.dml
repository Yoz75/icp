HorizontalLayout {
    layoutWidth: fill
    VerticalLayout {
        styleId: "ICP_DEFAULT_LAYOUT"
        layoutWidth: 200

        Button {
            id: persinalizationSettingsButton
            text: SettingsWindow_personalizationButton
        }

        Button { 
            id: generalSettingsButton
            text: SettingsWindow_generalButton
        }
    }

    FrameLayout {
        styleId: "ICP_DEFAULT_LAYOUT"
        id: settingsLayout;
        layoutWidth: fill
        
        VerticalLayout {
            styleId: "ICP_DEFAULT_LAYOUT"
            layoutWidth: fill
            layoutHeight: fill
            id: personalizationSettingsLayout

            ComboBox {
                id: themeSelectionComboBox
                items: ["Dark Neo", "Dark", "Light"]
            }

            ComboBox {
                id: localizationSelectionComboBox
                items: ["English", "Русский"]
            }
        }

        VerticalLayout { 
            id: generalSettingsLayout
            styleId: "ICP_DEFAULT_LAYOUT"
            layoutWidth: fill
            layoutHeight: fill

            CheckBox {
                id: cleanupGCCheckbox
                text: SettingsWindow_cleanupGCCheckbox
                checked: true;
            }

            TextWidget {
                text: SettingsWindow_pointInterpolationThresholdBox
            }

            FloatBox {
                layoutWidth: FILL_PARENT
                id: pointInterpolationThresholdBox
                min: 0.0
                defaultValue: 1.0
                step: 0.1
            }
        }
    }
}