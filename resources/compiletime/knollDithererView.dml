VerticalLayout {
    id: knollDithererView
    styleId: "ICP_DEFAULT_LAYOUT"

    TextWidget {
        text: BayerDithererView_levelBoxText
    }

    IntBox {
        id: levelBox
        layoutWidth: FILL_PARENT
        min: 0
        defaultValue: 1
        max: 8
    }

    TextWidget {
        text: BayerDitherer_strengthBoxText
    }

    FloatBox {
        id: strengthBox
        layoutWidth: FILL_PARENT
        min: 0.05
        defaultValue: 1.0
        max: 1.0
        step: 0.05
    }

    TextWidget {
        text: KnollDitherer_samplesBoxText
    }

    IntBox {
        id: samplesBox
        layoutWidth: FILL_PARENT
        min: 1
        defaultValue: 8
        max: 32
    }
}