HorizontalLayout {
    layoutWidth: fill
    VerticalLayout {
        styleId: "ICP_DEFAULT_LAYOUT"
        layoutWidth: 200

        Button {
            id: persinalizationSettingsButton
            text: "Personalization"
        }

        Button { 
            id: generalSettingsButton
            text: "General"
        }
    }

    FrameLayout {
        styleId: "ICP_DEFAULT_LAYOUT"
        id: settingsLayout;
        layoutWidth: fill
        
        VerticalLayout {
            styleId: "ICP_DEFAULT_LAYOUT"
            layoutWidth: fill
            layoutHeight: fill
            id: personalizationSettingsLayout

            ComboBox {
                id: themeSelectionComboBox
                items: ["Dark Neo", "Dark", "Light"]
            }
        }

        VerticalLayout { 
            id: generalSettingsLayout
            styleId: "ICP_DEFAULT_LAYOUT"
            layoutWidth: fill
            layoutHeight: fill

            CheckBox {
                id: cleanupGCCheckbox
                text: "Cleanup GC when done"
                checked: true;
            }
        }
    }
}